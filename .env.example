# Set these as process/user environment variables; Node does not auto-load this file.
PICKUP_WEB_HOST=127.0.0.1
PICKUP_WEB_PORT=8791
PGHOST=your-postgresql-host
PGPORT=5432
PGDATABASE=scrape_data
PGUSER=your-readonly-user
PGPASSWORD=replace-locally
DORIS_HOST=your-doris-host
DORIS_PORT=9030
DORIS_DATABASE=ywzt_ods
DORIS_USER=your-readonly-user
DORIS_PASSWORD=replace-locally
# Optional: INVENTORY_PYTHON, FUTURE_SALES_ROOT, DASHBOARD_SNAPSHOT_DIR
# External access requires existing server auth settings; do not expose unauthenticated APIs.
